# ============================================================
# WARISAN.AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi `.env` dan sesuaikan nilainya.
# PERINGATAN: Jangan pernah meng-commit file `.env` asli ke Git!
# ============================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=3000

# IBM Langflow Connection
# URL endpoint instans IBM Langflow lokal atau remote
LANGFLOW_BASE_URL=http://127.0.0.1:7860
# ID Flow Warisan.AI (didapat setelah impor warisan-ai-flow.json ke Langflow)
LANGFLOW_FLOW_ID=33240ff5-f4df-453c-9150-0767519d1d23
# API Key rahasia Langflow (jangan dibagikan)
LANGFLOW_API_KEY=your_langflow_api_key_here

# IBM Bob / MCP Integration
MCP_SERVER_NAME=lf-starter_project
MCP_TRANSPORT=streamablehttp
